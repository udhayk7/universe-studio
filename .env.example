# Universe Studio shared local environment
# Copy this file to .env for Docker Compose-driven local development.

COMPOSE_PROJECT_NAME=universe-studio

POSTGRES_DB=universe_studio
POSTGRES_USER=universe
POSTGRES_PASSWORD=universe_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://universe:universe_dev_password@postgres:5432/universe_studio

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=universe_dev_password
NEO4J_AUTH=neo4j/universe_dev_password

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=universe-assets

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_TIMEOUT_SECONDS=90
UNIVERSE_EXTRACTION_MAX_CHARS=60000

BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Universe Studio
