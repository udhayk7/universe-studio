APP_ENV=local
APP_NAME=Universe Studio API
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

DATABASE_URL=postgresql+psycopg://universe:universe_dev_password@localhost:5432/universe_studio

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=universe_dev_password

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=universe-assets

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_TIMEOUT_SECONDS=90
UNIVERSE_EXTRACTION_MAX_CHARS=60000
