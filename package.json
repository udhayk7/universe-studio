{
  "name": "universe-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "docker compose up",
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "lint": "pnpm --dir frontend lint",
    "typecheck": "pnpm --dir frontend typecheck",
    "format": "pnpm --dir frontend format",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f",
    "db:current": "./scripts/run_alembic.sh current",
    "db:history": "./scripts/run_alembic.sh history",
    "db:migrate": "./scripts/run_alembic.sh upgrade head",
    "demo:setup": "./scripts/setup_demo.sh",
    "demo:validate": "./scripts/validate_demo.sh",
    "backend:verify": "./scripts/verify_backend_environment.sh",
    "env:verify": "./scripts/verify_environment.sh",
    "openai:verify": "./scripts/verify_openai.sh"
  }
}
